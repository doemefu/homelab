---
# Secrets Template
#
# Setup (einmalig pro Maschine):
#   1. cp infra/inventory/group_vars/all.sops.yml.example \
#         infra/inventory/group_vars/all.sops.yml
#   2. Werte eintragen (siehe unten)
#   3. sops -e -i infra/inventory/group_vars/all.sops.yml
#   4. Verschlüsselte Datei committen (sicher — nur mit age-Key lesbar)
#
# Entschlüsseln zum Bearbeiten:
#   sops infra/inventory/group_vars/all.sops.yml
#
# Voraussetzung: age-Key unter ~/.config/age/homelab.key
# Voraussetzung: export SOPS_AGE_KEY_FILE=~/.config/age/homelab.key

# k3s Cluster-Token — identisch auf Server und allen Agents
# Generieren: openssl rand -hex 32
k3s_token: "CHANGE_ME_min_32_zeichen_langer_zufallsstring"

# Cloudflare API Token — Zone:DNS:Edit Berechtigung für furchert.ch
# Erstellen: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Berechtigung: Zone:DNS:Edit (für cert-manager DNS-01 Challenge)
cloudflare_api_token: "CHANGE_ME_cloudflare_api_token"

# Cloudflare Tunnel Token — Authentifizierungstoken für den cloudflared Pod
# Erstellen:
#   cloudflared tunnel create homelab
#   cloudflared tunnel token homelab
cloudflared_tunnel_token: "CHANGE_ME_cloudflared_tunnel_token"

# Cloudflare Account ID + Tunnel ID — für Ingress-Konfiguration via API
# Account ID: Cloudflare Dashboard → rechte Seite → Account ID
# Tunnel ID: kubectl logs -n platform deployment/cloudflared-cloudflare-tunnel-remote | grep tunnelID
cloudflare_account_id: "CHANGE_ME_cloudflare_account_id"
cloudflare_tunnel_id: "CHANGE_ME_cloudflare_tunnel_id"

# Cloudflare Tunnel API Token — Tunnel:Edit Berechtigung (separates Token!)
# Erstellen: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Berechtigung: Account:Cloudflare Tunnel:Edit
# WICHTIG: Nicht mit cloudflare_api_token verwechseln — der hat nur DNS:Edit, kein Tunnel:Edit
cloudflare_tunnel_api_token: "CHANGE_ME_cloudflare_tunnel_api_token"

# Grafana Admin-Passwort — für Grafana-Login (grafana.furchert.ch)
# Wählen: beliebiges sicheres Passwort
grafana_admin_password: "CHANGE_ME_grafana_admin_password"

# Restic Backup-Passwort — für Restic-Repository auf raspi5 (/var/lib/backup/restic-repo)
# Generieren: openssl rand -base64 32
# WICHTIG: Verlust bedeutet kein Zugriff auf Backups — sicher aufbewahren
restic_password: "CHANGE_ME_restic_password"

# Alertmanager Discord Webhook URL
# Erstellen: Discord Server → Kanal-Einstellungen → Integrationen → Webhooks → Neuer Webhook → URL kopieren
# Format: https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYY
alertmanager_discord_webhook_url: "CHANGE_ME_https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYY"

postgresql_password: "<generieren: openssl rand -base64 24>"
postgresql_replication_password: "<generieren: openssl rand -base64 24>"
influxdb_admin_password: "<min 8 Zeichen>"
influxdb_admin_token: "<generieren: openssl rand -hex 32>"

# Homelab DB user — used by auth-service / device-service for `homelabdb`
# Created idempotently by 59_app_services.yml on the in-cluster PostgreSQL.
# Username must match: ^[a-z_][a-z0-9_]*$
homelab_db_username: "homelab"
homelab_db_password: "CHANGE_ME_openssl_rand_base64_24"

# MQTT password for device-service (Mosquitto auth)
# Placeholder until MQTT auth is enabled post-M6 — generate now to avoid empty value.
# Generate: openssl rand -base64 24
device_service_mqtt_password: "CHANGE_ME_openssl_rand_base64_24"

# auth-service OAuth2 client secrets (per relying party)
# Grafana: created in Grafana → Administration → Authentication → Generic OAuth
# Home Assistant: created in HA → Settings → OAuth Clients
# device-service / n8n / litellm: choose any random value (openssl rand -hex 32)
# Note: 59_app_services.yml wraps these with "{noop}" before writing to the auth-service secret.
auth_service_grafana_client_secret: "CHANGE_ME_grafana_client_secret"
auth_service_ha_client_secret: "CHANGE_ME_homeassistant_client_secret"
auth_service_device_service_client_secret: "CHANGE_ME_openssl_rand_hex_32"

# auth-service RSA keypair used for JWT signing.
# Generate once and paste both halves verbatim (PEM format, preserving line breaks):
#   openssl genrsa -out /tmp/auth-rsa.pem 2048
#   openssl rsa -in /tmp/auth-rsa.pem -pubout -out /tmp/auth-rsa-pub.pem
#   cat /tmp/auth-rsa.pem        # → auth_service_rsa_private_key
#   cat /tmp/auth-rsa-pub.pem    # → auth_service_rsa_public_key
#   shred -u /tmp/auth-rsa.pem /tmp/auth-rsa-pub.pem
auth_service_rsa_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  CHANGE_ME_paste_PEM_body_here
  -----END RSA PRIVATE KEY-----
auth_service_rsa_public_key: |
  -----BEGIN PUBLIC KEY-----
  CHANGE_ME_paste_PEM_body_here
  -----END PUBLIC KEY-----

# Sentry DSN — obtain from sentry.io project settings → Client Keys
# One DSN shared across all three homelab microservices (auth, device, data)
sentry_dsn: "https://REPLACE_ME@oXXXXXXXX.ingest.sentry.io/XXXXXXXX"

# n8n OIDC client credentials and encryption key
auth_service_n8n_client_secret: "CHANGE_ME_generate_secure_password"
n8n_encryption_key: "CHANGE_ME_generate_secure_key_openssl_rand_hex_32"

# LiteLLM AI Gateway credentials
# litellm_master_key: bearer token for API access — share with Claude Code (ANTHROPIC_AUTH_TOKEN)
#   Format: must start with "sk-"
#   Generate: echo "sk-$(openssl rand -hex 16)"
litellm_master_key: "sk-CHANGE_ME_openssl_rand_hex_16"

# litellm_salt_key: used to encrypt virtual keys stored in the database.
#   WARNING: this value is PERMANENT — changing it after first use makes all stored keys unrecoverable.
#   Generate: openssl rand -hex 32
litellm_salt_key: "CHANGE_ME_openssl_rand_hex_32"

# litellm_db_password: Postgres password for the litellm database user
#   Generate: openssl rand -hex 16
litellm_db_password: "CHANGE_ME_openssl_rand_hex_16"

# Mistral API key — from https://console.mistral.ai/api-keys
mistral_api_key: "CHANGE_ME_mistral_api_key"

# Dedicated Mistral key for the Codestral route (kept separate intentionally)
mistral_codestral_api_key: "CHANGE_ME_mistral_codestral_api_key"

# LiteLLM OIDC client secret — shared with auth-service for SSO UI login
# Generate: openssl rand -hex 32
litellm_client_secret: "CHANGE_ME_openssl_rand_hex_32"

# furchert-ch Auth.js session secret (openssl rand -base64 33)
furchert_ch_auth_secret: "CHANGE_ME_openssl_rand_base64_33"

# furchert-ch OIDC client secret, plain value (auth-service stores it "{noop}"-prefixed)
auth_service_furchert_ch_client_secret: "CHANGE_ME_openssl_rand_hex_32"

# Infomaniak application password for info@furchert.ch (contact-form SMTP, furchert-ch#46)
furchert_ch_smtp_password: "CHANGE_ME_infomaniak_smtp_app_password"

# data-service Postgres password for the data_service role/DB (docs/060-network-monitoring.md §9)
# Created idempotently by 59_app_services.yml; materialised as data-service-secrets/db-password.
# Generate: openssl rand -hex 24
data_service_db_password: "CHANGE_ME_openssl_rand_hex_24"

# data-service Cloudflare GraphQL Analytics access (NM-1, docs/060-network-monitoring.md §4.2, §9)
# Materialised by 59_app_services.yml as data-service-secrets/cloudflare-api-token and cloudflare-zone-id.
# Token: Cloudflare Dashboard → My Profile → API Tokens → Create Token → Custom token,
#        permission Zone → Analytics → Read, zone resources: furchert.ch only.
#        Separate token — not cloudflare_api_token (DNS:Edit) and not the tunnel tokens.
data_service_cloudflare_analytics_token: "CHANGE_ME_cloudflare_analytics_read_token"
# Zone ID (not a credential): Cloudflare Dashboard → furchert.ch → Overview → API → Zone ID
data_service_cloudflare_zone_id: "CHANGE_ME_cloudflare_zone_id"

# data-service AbuseIPDB key (NM-1 follow-up, docs/060-network-monitoring.md §4.5, §9) — OPTIONAL.
# Free plan key from abuseipdb.com (1 000 checks/day; data-service uses at most 200/day, 10 per run).
# Materialised by 59_app_services.yml as data-service-secrets/abuseipdb-api-key and enables the
# reputation collector. Unset = skipped; set but empty = the playbook fails.
# data_service_abuseipdb_key: "CHANGE_ME_abuseipdb_api_key"

# NM-4 login events (docs/060-network-monitoring.md §7.6, §9) — OPTIONAL, set both or neither.
# Without them, 59_app_services.yml skips these keys and auth-service keeps login-event capture off;
# with only one of them, the playbook fails. Restart auth-service and data-service after adding them.
# auth_service_data_service_client_secret: plain value, NO "{noop}" prefix — the playbook writes
#   "{noop}<value>" to homelab-auth-secrets/data-service-client-secret (auth-service) and
#   "<value>" to data-service-secrets/auth-client-secret (data-service).
#   Generate: openssl rand -hex 32
# auth_service_login_event_hmac_key: at least 32 characters (shorter keys are rejected by the
#   playbook and would keep the feature off in auth-service). auth-service only.
#   Rotating it breaks HMAC continuity for login events already stored in data-service.
#   Generate: openssl rand -base64 48
# auth_service_data_service_client_secret: "CHANGE_ME_openssl_rand_hex_32"
# auth_service_login_event_hmac_key: "CHANGE_ME_openssl_rand_base64_48_min_32_chars"
